<form version="1.1" theme="dark" script="dashboard_state_v2.js,command_center.js,analysis_bridge.js,environment_intelligence_v2.js,dei_environment_scan_v1.js,dei_guide_adapter_v8.js,dei_workspace_layout_v14.js,dei_theme_v1.js" stylesheet="command_center_v2.css,environment_intelligence.css,environment_intelligence_v2.css,dei_visual_polish_v1.css,dei_workspace_layout_v1.css,dei_guided_tour_v6.css,dei_responsive_v1.css,dei_design_system_v2.css,dei_theme_v1.css">
  <label>DEI Environment Discovery</label>
  <description>Run a fresh telemetry intelligence scan and generate the active environment analysis for this session.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <div id="dei-command-center" class="dei-shell dei-environment-discovery">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Environment Discovery</span></div></div>
            <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a class="active" href="command_center">Discover</a><a href="mitre_coverage">Coverage</a><a href="detection_workflow">Build</a><a href="detection_catalog">Operate</a><a href="detection_health">Health</a></nav>
            <div id="dei-api-status" class="dei-status">API status: checking</div>
          </section>

          <section id="dei-telemetry" class="dei-control-panel">
            <div class="dei-control-header"><div><p class="dei-eyebrow">Environment Intelligence</p><h2>Telemetry discovery</h2><p>Known source types remain visible while recent evidence determines production readiness.</p></div><span id="dei-window-note" class="dei-control-note">30-day known · 7-day active</span></div>
            <div class="dei-source-frame"><div class="dei-source-frame-head"><span>Known telemetry routes</span><small id="dei-source-summary">Active ≤7d · Stale 8d–selected window</small></div><textarea id="dei-sources" aria-label="Known telemetry routes discovered by the intelligence scan" rows="7" readonly="readonly" placeholder="Run environment analysis to discover index and sourcetype routes..."></textarea></div>
            <div class="dei-actions"><div class="dei-scan-options"><label class="dei-toggle"><input id="dei-es-enabled" type="checkbox"/><span class="dei-toggle-track"></span><span>Enterprise Security enabled</span></label><label class="dei-toggle" title="Off by default. Enable only when Splunk internal and results indexes are intentionally part of the detection use case."><input id="dei-include-internal-indexes" type="checkbox"/><span class="dei-toggle-track"></span><span>Include internal indexes</span></label><label class="dei-window-select"><span>Discovery window</span><select id="dei-discovery-window"><option value="7">7 days</option><option value="30" selected="selected">30 days</option><option value="90">90 days</option></select></label></div><button id="dei-analyze" type="button"><span>Run intelligence scan</span><b>→</b></button></div>
            <p id="dei-feedback" class="dei-feedback" aria-live="polite"></p>
          </section>

          <section id="dei-discovery-next" class="dei-discovery-next" aria-labelledby="dei-discovery-next-title" aria-live="polite" hidden="hidden">
            <div class="dei-discovery-next-copy"><span id="dei-discovery-result-state" data-state="waiting">Waiting for analysis</span><div><p class="dei-eyebrow">Recommended next step</p><h2 id="dei-discovery-next-title">Continue in the detection workspace</h2><p id="dei-discovery-next-summary">The completed scan will carry its recommendations into one guided workspace for selection, generation, validation, review, deployment evidence, and monitoring.</p></div></div>
            <div class="dei-discovery-next-action"><a id="dei-open-environment-insights" class="primary" href="detection_workflow">Continue to Guided Detection Builder →</a><a id="dei-review-scan-results" href="mitre_coverage">Optional: inspect ATT&amp;CK coverage</a></div>
          </section>

          <div id="recommendations" style="display:none"></div><span id="recommendation-count" style="display:none"></span>
        </div>
      </html>
    </panel>
  </row>
</form>

<form version="1.1" theme="dark" script="dashboard_state_v2.js,command_center.js,analysis_bridge.js,environment_intelligence_v2.js,dei_environment_scan_v1.js,dei_workspace_layout_v8.js" stylesheet="command_center_v2.css,environment_intelligence.css,environment_intelligence_v2.css,dei_visual_polish_v1.css,dei_workspace_layout_v1.css,dei_guided_tour_v3.css">
  <label>DEI Environment Discovery</label>
  <description>Run a fresh telemetry intelligence scan and generate the active environment analysis for this session.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <div id="dei-command-center" class="dei-shell dei-environment-discovery">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Environment Discovery</span></div></div>
            <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a class="active" href="command_center">Environment</a><a href="mitre_coverage">MITRE ATT&amp;CK</a><a href="detection_workflow">Guided Builder</a><a href="detection_lifecycle">Lifecycle</a></nav>
            <div id="dei-api-status" class="dei-status">API status: checking</div>
          </section>

          <section id="dei-telemetry" class="dei-control-panel">
            <div class="dei-control-header"><div><p class="dei-eyebrow">Environment Intelligence</p><h2>Telemetry discovery</h2><p>Active source types observed across searchable indexes during the current seven-day analysis window.</p></div><span class="dei-control-note">7-day active telemetry window</span></div>
            <div class="dei-source-frame"><div class="dei-source-frame-head"><span>Discovered source types</span><small>Populated by this scan only</small></div><textarea id="dei-sources" rows="7" readonly="readonly" placeholder="Run environment analysis to discover active Splunk telemetry..."></textarea></div>
            <div class="dei-actions"><label class="dei-toggle"><input id="dei-es-enabled" type="checkbox"/><span class="dei-toggle-track"></span><span>Enterprise Security enabled</span></label><button id="dei-analyze" type="button"><span>Run intelligence scan</span><b>→</b></button></div>
            <p id="dei-feedback" class="dei-feedback" aria-live="polite"></p>
          </section>

          <section id="dei-discovery-next" class="dei-discovery-next" aria-labelledby="dei-discovery-next-title">
            <div><p class="dei-eyebrow">Analysis Results</p><h2 id="dei-discovery-next-title">Continue to environment intelligence</h2><p>Open the readiness, telemetry DNA, ATT&amp;CK coverage, portfolio, and snapshot details produced by this discovery.</p></div>
            <div class="dei-discovery-next-action"><span id="dei-discovery-result-state">Waiting for analysis</span><a id="dei-open-environment-insights" href="environment_insights">View intelligence results →</a></div>
          </section>

          <div id="recommendations" style="display:none"></div><span id="recommendation-count" style="display:none"></span>
        </div>
      </html>
    </panel>
  </row>
</form>

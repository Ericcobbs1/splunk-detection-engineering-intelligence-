<form version="1.1" theme="dark" script="dashboard_state_v2.js,command_center.js,analysis_bridge.js,environment_intelligence_v2.js" stylesheet="command_center_v2.css,environment_intelligence.css,environment_intelligence_v2.css,dei_visual_polish_v1.css">
  <label>DEI Command Center</label>
  <description>Telemetry intelligence and detection readiness overview.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <div id="dei-command-center" class="dei-shell">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Command Center</span></div></div>
            <nav class="dei-workspace-nav"><a class="active" href="#dei-overview">Overview</a><a href="#dei-telemetry">Telemetry</a><a href="#dei-portfolio-section">Portfolio</a><a href="#dei-coverage-section">Coverage</a><a href="mitre_coverage">MITRE ATT&amp;CK</a></nav>
            <div id="dei-api-status" class="dei-status">API status: checking</div>
          </section>

          <section id="dei-overview" class="dei-hero">
            <div class="dei-hero-copy"><p class="dei-eyebrow">Security Operations Intelligence</p><h1>Turn telemetry into detection readiness.</h1><p class="dei-subtitle">Understand the data you have, identify what is detection-ready, and prioritize the engineering work that closes the highest-value coverage gaps.</p><div class="dei-hero-tags"><span>Telemetry intelligence</span><span>Field-aware readiness</span><span>Explainable recommendations</span><span>ES-aware</span></div></div>
            <div class="dei-hero-visual" aria-hidden="true"><div class="dei-orbit dei-orbit-one"></div><div class="dei-orbit dei-orbit-two"></div><div class="dei-core-mark"><span>DEI</span><small>INTELLIGENCE</small></div></div>
          </section>

          <section class="dei-metrics" aria-label="Detection intelligence summary">
            <article class="dei-metric metric-primary"><span>Observed sources</span><strong id="metric-sources">0</strong><small>active telemetry</small></article>
            <article class="dei-metric"><span>Telemetry understanding</span><strong id="metric-understanding">0%</strong><small>mapped source types</small></article>
            <article class="dei-metric metric-success"><span>Production ready</span><strong id="metric-ready">0</strong><small>deployable opportunities</small></article>
            <article class="dei-metric metric-warning"><span>Partial coverage</span><strong id="metric-partial">0</strong><small>needs remediation</small></article>
            <article class="dei-metric metric-accent"><span>Detection potential</span><strong id="metric-potential">0%</strong><small>portfolio readiness</small></article>
          </section>

          <section id="dei-telemetry" class="dei-control-panel">
            <div class="dei-control-header"><div><p class="dei-eyebrow">Environment Intelligence</p><h2>Telemetry discovery</h2><p>Active source types observed across searchable indexes during the current seven-day analysis window.</p></div><span class="dei-control-note">7-day active telemetry window</span></div>
            <div class="dei-source-frame"><div class="dei-source-frame-head"><span>Discovered source types</span><small>Persistent snapshot until refresh</small></div><textarea id="dei-sources" rows="7" readonly="readonly" placeholder="Run environment analysis to discover active Splunk telemetry..."></textarea></div>
            <div class="dei-actions"><label class="dei-toggle"><input id="dei-es-enabled" type="checkbox"/><span class="dei-toggle-track"></span><span>Enterprise Security enabled</span></label><button id="dei-analyze" type="button"><span>Analyze environment</span><b>→</b></button></div>
            <p id="dei-feedback" class="dei-feedback" aria-live="polite"></p>
          </section>

          <section id="dei-portfolio-section" class="dei-portfolio" aria-label="Detection portfolio">
            <div class="dei-portfolio-heading"><div><p class="dei-eyebrow">Detection Portfolio</p><h2>Readiness at a glance</h2><p>Operational view of deployable detections, remediation work, and evidence gaps.</p></div><span id="portfolio-total" class="dei-chip">0 opportunities</span></div>
            <div class="dei-portfolio-grid"><article class="portfolio-ready"><span class="dei-dot ready"></span><div><strong id="portfolio-ready">0</strong><small>Production ready</small></div></article><article class="portfolio-partial"><span class="dei-dot partial"></span><div><strong id="portfolio-partial">0</strong><small>Partial / field gaps</small></div></article><article class="portfolio-gap"><span class="dei-dot gap"></span><div><strong id="portfolio-field-gaps">0</strong><small>Confirmed field gaps</small></div></article><article class="portfolio-unverified"><span class="dei-dot unverified"></span><div><strong id="portfolio-unverified">0</strong><small>Field unverified</small></div></article></div>
          </section>

          <section id="dei-coverage-section" class="dei-environment-v2" aria-label="Telemetry DNA and ATT&amp;CK coverage intelligence">
            <div class="dei-env-titlebar">
              <div><p class="dei-eyebrow">Environment Intelligence</p><h2>Telemetry DNA + ATT&amp;CK Coverage</h2><p>One persistent snapshot of detection potential, telemetry-domain distribution, and ATT&amp;CK effectiveness analysis.</p></div>
              <div class="dei-env-title-actions"><span id="environment-snapshot-age" class="dei-snapshot-pill">No saved snapshot</span><button id="dei-clear-environment" class="dei-clear-button-v2" type="button"><span>×</span> Clear dashboard</button><button id="dei-refresh-environment" class="dei-refresh-button-v2" type="button"><span>↻</span> Refresh environment</button></div>
            </div>

            <div class="dei-env-summary-card">
              <article class="dei-env-summary-section dei-env-potential">
                <h3>Detection Potential</h3>
                <div class="dei-potential-content"><div id="coverage-ring" class="dei-ring dei-ring-v2"><span id="coverage-value">0%</span><small>potential</small></div><div><span id="coverage-label" class="dei-state-label">Not analyzed</span><p>Weighted readiness across evaluated detection opportunities.</p></div></div>
              </article>
              <article class="dei-env-summary-section dei-env-attack-summary">
                <h3>ATT&amp;CK Coverage <small>by tactic</small></h3>
                <div class="dei-attack-summary-grid"><div class="covered"><strong id="env-tactics-covered">0</strong><span>Covered</span></div><div class="partial"><strong id="env-tactics-partial">0</strong><span>Partial</span></div><div class="uncovered"><strong id="env-tactics-uncovered">0</strong><span>Not covered</span></div><div id="env-tactic-donut" class="dei-tactic-donut"><strong>15</strong><span>Total tactics</span></div></div>
              </article>
              <article class="dei-env-summary-section dei-env-top-domains">
                <h3>Top Telemetry Domains</h3>
                <div id="env-top-domains" class="dei-top-domain-list"><p class="dei-empty">Analyze the environment to populate domains.</p></div>
              </article>
              <article class="dei-env-summary-section dei-env-mitre-cta">
                <span class="dei-env-kicker">ATT&amp;CK</span><h3>Detection effectiveness workspace</h3><p>Inspect tactic and technique coverage, mapped detections, offline framework context, and protection detail.</p><a class="dei-mitre-glow-button" href="mitre_coverage">Open MITRE ATT&amp;CK <b>↗</b></a>
              </article>
            </div>

            <div class="dei-env-detail-grid">
              <article class="dei-env-detail-card dei-domain-distribution-card">
                <div class="dei-env-card-head"><div><h3>Telemetry Domain Distribution</h3><p>Detection opportunities grouped by telemetry domain.</p></div></div>
                <div class="dei-domain-distribution-body"><div id="env-domain-donut" class="dei-domain-donut"><strong id="env-domain-count">0</strong><span>domains</span></div><div id="env-domain-legend" class="dei-domain-legend"></div></div>
                <div id="coverage-domains" class="dei-domain-list dei-domain-list-compact"></div>
              </article>

              <article class="dei-env-detail-card dei-tactic-coverage-card">
                <div class="dei-env-card-head"><div><h3>ATT&amp;CK Coverage by Tactic</h3><p>Weighted readiness across mapped detections for the 15 Enterprise ATT&amp;CK tactics.</p></div><span class="dei-mode-pill">Coverage %</span></div>
                <div id="env-tactic-bars" class="dei-tactic-bars"><p class="dei-empty">Analyze the environment to calculate tactic coverage.</p></div>
                <div class="dei-tactic-legend"><span class="covered">Covered</span><span class="partial">Partial</span><span class="uncovered">Not covered</span><span class="nodata">No mapped detections</span></div>
                <a class="dei-view-mitre-button" href="mitre_coverage">View in MITRE ATT&amp;CK workspace <b>↗</b></a>
              </article>

              <aside class="dei-env-detail-card dei-snapshot-card">
                <div class="dei-env-card-head"><div><h3>Snapshot Details</h3><p>Current persisted environment analysis.</p></div></div>
                <dl class="dei-snapshot-list"><div><dt>Index scope</dt><dd id="env-index-count">0 indexes</dd></div><div><dt>Source types</dt><dd id="env-source-count">0 source types</dd></div><div><dt>Time range</dt><dd>Last 7 days</dd></div><div><dt>Total events</dt><dd id="env-event-count">0</dd></div><div><dt>Detections evaluated</dt><dd id="env-detection-count">0</dd></div><div><dt>Enterprise Security</dt><dd id="env-es-state">Not enabled</dd></div></dl>
              </aside>
            </div>

            <div class="dei-env-persistence-note">ⓘ This snapshot remains loaded while you navigate the app. Select <strong>Refresh environment</strong> to replace it with fresh analysis, or <strong>Clear dashboard</strong> to remove it before another query.</div>
          </section>

          <div id="recommendations" style="display:none"></div><span id="recommendation-count" style="display:none"></span>
        </div>
      </html>
    </panel>
  </row>
</form>

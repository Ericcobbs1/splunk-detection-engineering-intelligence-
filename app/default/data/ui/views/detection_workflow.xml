<form version="1.1" theme="dark" script="dei_lifecycle_store_v1.js,detection_workflow_v1.js,dei_environment_scan_v1.js,dei_workspace_layout_v1.js" stylesheet="command_center_v2.css,dei_visual_polish_v1.css,detection_lifecycle_v1.css,dei_workspace_layout_v1.css,detection_workflow_v1.css">
  <label>Guided Detection Workflow</label>
  <description>A simplified, detection-specific journey through engineering, approval, enablement, and monitoring.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <main id="dei-guided-detection-page" class="dei-shell dei-guided-detection-page">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Guided Workflow</span></div></div>
            <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a href="command_center">Environment</a><a href="mitre_coverage">MITRE ATT&amp;CK</a><a href="detection_builder">Builder</a><label class="dei-lifecycle-workspace-menu"><span>Lifecycle workspace</span><select id="lifecycle-workspace-menu"><option value="detection_workflow" selected="selected">Guided Workflow</option><option value="detection_lifecycle">Lifecycle Overview</option><option value="detection_operations">Engineering Operations</option><option value="detection_catalog">Detection Catalog</option><option value="detection_builder">Detection Builder</option></select></label></nav>
            <div id="workflow-data-status" class="dei-status">Workflow: loading</div>
          </section>

          <header class="dei-workflow-hero">
            <div><p class="dei-eyebrow">Guided Detection Workflow</p><h1>Move one detection forward at a time.</h1><p>Select a detection. DEI will explain its current position, show only what is required now, and send you to the exact next action.</p></div>
            <a href="detection_lifecycle">View lifecycle overview →</a>
          </header>

          <section class="dei-workflow-selector" aria-labelledby="workflow-selector-title">
            <div><span>Detection</span><h2 id="workflow-selector-title">Choose where to continue</h2></div>
            <select id="workflow-detection-select" aria-label="Detection workflow"><option value="">Select a detection</option></select>
          </section>

          <section id="workflow-empty" class="dei-workflow-empty"><strong>Select a detection to begin.</strong><p>Run an environment scan first if no detection recommendations are available.</p><button class="dei-run-intelligence-scan" type="button">Run intelligence scan →</button></section>

          <section id="workflow-driver" class="dei-workflow-driver" hidden="hidden" aria-labelledby="workflow-detection-title">
            <div class="dei-workflow-current">
              <div><p id="workflow-stage-count">Stage 1 of 9</p><h2 id="workflow-detection-title">Detection</h2><div id="workflow-detection-meta"></div></div>
              <span id="workflow-current-stage">Current stage: Recommendation</span>
            </div>
            <ol id="workflow-stage-rail" class="dei-workflow-stage-rail" aria-label="Detection lifecycle stages"></ol>

            <div class="dei-workflow-focus-grid">
              <article class="dei-workflow-next-card">
                <p>Do this next</p><h3 id="workflow-next-title">Review the recommendation</h3><p id="workflow-next-explanation"></p>
                <div id="workflow-requirements" class="dei-workflow-requirements"></div>
                <a id="workflow-primary-action" href="detection_builder">Continue →</a>
                <small id="workflow-action-note">You will open the exact detection in its owning workspace.</small>
              </article>
              <aside class="dei-workflow-help-card">
                <p>Why this stage matters</p><h3 id="workflow-why-title">Evidence before action</h3><p id="workflow-why-text"></p>
                <details><summary>View advanced evidence</summary><div id="workflow-advanced-evidence"></div></details>
              </aside>
            </div>
          </section>
        </main>
      </html>
    </panel>
  </row>
</form>

<form version="1.1" theme="dark" script="dei_environment_scan_v1.js,dei_lifecycle_store_v1.js,detection_action_center_v1.js,dei_guide_adapter_v8.js,dei_workspace_layout_v14.js,dei_theme_v1.js" stylesheet="command_center_v2.css,dei_visual_polish_v1.css,dei_workspace_layout_v1.css,detection_action_center_v1.css,dei_guided_tour_v6.css,dei_responsive_v1.css,dei_design_system_v2.css,dei_theme_v1.css">
  <label>Detection Action Center</label>
  <description>Prioritized detection findings, evidence gaps, and remediation actions.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <main id="dei-action-center-page" class="dei-shell dei-action-center">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Action Center</span></div></div>
<nav class="dei-workspace-nav" aria-label="Primary workspaces"><a href="dei_home">Home</a><a href="command_center">Discover</a><a href="mitre_coverage">Coverage</a><a href="detection_workflow">Build</a><a class="active" href="detection_catalog">Detection Catalog</a><a href="detection_health">Health</a></nav>
          </section>

          <header class="dei-action-center-hero">
            <div><p class="dei-kicker">Detection Action Center</p><h1>Resolve the next pipeline blockers.</h1><p>Review prioritized telemetry, validation, and monitoring findings without crowding the operational home page.</p></div>
            <a id="action-return-to-detection" href="dei_home">Return to operational home →</a>
          </header>

          <section class="dei-action-summary" aria-label="Action item summary">
            <button type="button" data-action-summary="all" class="active"><span>All findings</span><strong id="action-count-all">0</strong></button>
            <button type="button" data-action-summary="critical"><span>Critical</span><strong id="action-count-critical">0</strong></button>
            <button type="button" data-action-summary="telemetry"><span>Telemetry / fields</span><strong id="action-count-telemetry">0</strong></button>
            <button type="button" data-action-summary="validation"><span>Validation failed</span><strong id="action-count-validation">0</strong></button>
            <button type="button" data-action-summary="monitoring"><span>Monitoring</span><strong id="action-count-monitoring">0</strong></button>
          </section>

          <section class="dei-action-workspace" aria-labelledby="action-workspace-title">
            <div class="dei-action-workspace-head"><div><p class="dei-eyebrow">Prioritized work queue</p><h2 id="action-workspace-title">Findings requiring action</h2><p id="action-results-summary" aria-live="polite">Loading pipeline evidence…</p></div><button id="action-refresh" type="button">Refresh evidence</button></div>
            <div class="dei-action-filters" aria-label="Filter action items">
              <label><span>Search</span><input id="action-search" type="search" placeholder="Detection, sourcetype, MITRE ID, or field" /></label>
              <label><span>Severity</span><select id="action-severity"><option value="all">All severities</option><option value="critical">Critical</option><option value="attention">Attention</option></select></label>
              <label><span>Finding type</span><select id="action-category"><option value="all">All finding types</option><option value="telemetry">Telemetry / field evidence</option><option value="validation">Validation failed</option><option value="monitoring">Monitoring health</option></select></label>
              <label><span>Readiness</span><select id="action-readiness"><option value="all">All readiness states</option><option value="field_gap">Field gap</option><option value="field_unverified">Field unverified</option><option value="partial">Partial</option><option value="unsupported">Unsupported</option><option value="requires_es">Requires ES</option></select></label>
              <button id="action-reset-filters" type="button">Reset filters</button>
            </div>
            <div id="action-loading" class="dei-action-empty">Loading recommendation and lifecycle evidence…</div>
            <div id="action-empty" class="dei-action-empty" hidden="hidden"><strong>No findings match these filters.</strong><p>Reset the filters or run a fresh environment intelligence scan.</p><a class="dei-link-button dei-scan-discovery-link" href="command_center#dei-telemetry">Open Environment Discovery →</a></div>
            <div id="action-findings" class="dei-action-findings" aria-live="polite"></div>
          </section>
        </main>
      </html>
    </panel>
  </row>
</form>

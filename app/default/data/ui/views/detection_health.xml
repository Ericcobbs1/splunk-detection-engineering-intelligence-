<form version="1.1" theme="dark" script="dei_lifecycle_store_v1.js,detection_health_v1.js,dei_detection_usability_v1.js,dei_environment_scan_v1.js,dei_guide_adapter_v8.js,dei_workspace_layout_v14.js,dei_theme_v1.js" stylesheet="command_center_v2.css,dei_visual_polish_v1.css,dei_workspace_layout_v1.css,dei_guided_tour_v6.css,dei_responsive_v1.css,dei_design_system_v2.css,dei_detection_usability_v1.css,dei_theme_v1.css">
  <label>Detection Health</label>
  <description>Operational health, validation evidence, and direct remediation for managed detections.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row><panel><html>
    <div id="dei-detection-health-page" class="dei-shell dei-health-page">
      <section class="dei-product-bar" aria-label="DEI workspace navigation">
        <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Detection Health</span></div></div>
        <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a href="command_center">Discover</a><a href="mitre_coverage">Coverage</a><a href="detection_workflow">Build</a><a href="detection_catalog">Operate</a><a class="active" href="detection_health">Health</a></nav>
      </section>
      <header class="dei-health-hero"><div><p class="dei-eyebrow">Operational assurance</p><h1>Detection Health</h1><p>Current lifecycle and validation evidence identifies what is healthy, what is stale, and exactly what requires action.</p></div><button id="health-refresh" class="dei-secondary-action" type="button"><span aria-hidden="true">↻</span> Refresh health</button></header>
      <section class="dei-health-summary" aria-label="Detection health summary">
        <article><span>Managed</span><strong id="health-managed">0</strong></article><article><span>Healthy</span><strong id="health-healthy">0</strong></article><article><span>Attention</span><strong id="health-attention">0</strong></article><article><span>Failed</span><strong id="health-failed">0</strong></article><article><span>Unvalidated</span><strong id="health-unvalidated">0</strong></article>
      </section>
      <section class="dei-health-visuals" aria-label="Health charts">
        <article class="dei-health-distribution"><div><p class="dei-eyebrow">Portfolio distribution</p><h2>Detection health</h2><p>The chart and legend use labels as well as color so every state remains clear.</p></div><div id="health-donut" class="dei-health-donut" role="img" aria-label="No managed detection health evidence"><div><strong id="health-donut-total">0</strong><span>managed</span></div></div><div class="dei-health-legend"><span data-state="healthy">Healthy <b id="health-legend-healthy">0</b></span><span data-state="attention">Attention <b id="health-legend-attention">0</b></span><span data-state="failed">Failed <b id="health-legend-failed">0</b></span><span data-state="unvalidated">Unvalidated <b id="health-legend-unvalidated">0</b></span></div></article>
        <article class="dei-health-readiness"><div><p class="dei-eyebrow">Evidence readiness</p><h2><span id="health-ready-percent">0%</span> ready</h2><p>Managed detections with current passing validation evidence.</p></div><div class="dei-health-bar" role="progressbar" aria-label="Detection evidence readiness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="health-ready-bar"></span></div><div class="dei-health-bar-labels"><span>Needs evidence</span><strong id="health-ready-label">0 of 0 ready</strong></div></article>
      </section>
      <section class="dei-health-workspace"><div class="dei-health-controls"><input id="health-filter" type="search" placeholder="Filter detections, MITRE, sourcetype, or issue"/><select id="health-state"><option value="all">All health states</option><option value="healthy">Healthy</option><option value="attention">Attention required</option><option value="failed">Failed</option><option value="unvalidated">Unvalidated</option></select></div>
        <div id="health-evidence-status" class="dei-builder-feedback ready" role="status" aria-live="polite">Loading current lifecycle evidence…</div>
        <div id="health-records" class="dei-health-records"></div>
      </section>
    </div>
  </html></panel></row>
</form>

<form version="1.1" theme="dark" script="dei_lifecycle_store_v1.js,detection_lifecycle_v2.js,dei_environment_scan_v1.js,dei_interactive_guide_v1.js,dei_guide_adapter_v1.js,dei_workspace_layout_v12.js" stylesheet="command_center_v2.css,dei_visual_polish_v1.css,detection_lifecycle_v1.css,dei_workspace_layout_v1.css,dei_guided_tour_v5.css,dei_responsive_v1.css">
  <label>Detection Engineering Lifecycle</label>
  <description>Evidence-driven detection engineering framework, lifecycle metrics, and work queue.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <div id="dei-lifecycle-page" class="dei-shell dei-lifecycle-page">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Detection Lifecycle</span></div></div>
            <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a href="command_center">Environment</a><a href="mitre_coverage">MITRE ATT&amp;CK</a><a href="detection_workflow">Guided Builder</a><label class="dei-lifecycle-workspace-menu"><span>Lifecycle workspace</span><select id="lifecycle-workspace-menu"><option value="detection_workflow">Guided Detection Builder</option><option value="detection_lifecycle" selected="selected">Lifecycle Overview</option><option value="detection_operations">Engineering Operations</option><option value="detection_catalog">Detection Catalog</option></select></label></nav>
            <div id="lifecycle-data-status" class="dei-status">Analysis: checking</div>
          </section>

          <section class="dei-lifecycle-hero">
            <div>
              <p class="dei-eyebrow">Detection Engineering Framework</p>
              <h1>From telemetry evidence to managed detection coverage.</h1>
              <p>DEI connects environment discovery, field qualification, ATT&amp;CK-aligned recommendations, detection design, generated SPL, historical validation, review, deployment, monitoring, tuning, and retirement.</p>
            </div>
            <div class="dei-lifecycle-hero-state"><span id="lifecycle-analysis-age">No analysis loaded</span><strong id="lifecycle-maturity-percent">0%</strong><small>current framework maturity</small></div>
          </section>

          <section class="dei-lifecycle-metrics" aria-label="Detection engineering metrics">
            <article><span>Sourcetypes analyzed</span><strong id="life-sources">0</strong><small>observed telemetry</small></article>
            <article><span>Detection opportunities</span><strong id="life-opportunities">0</strong><small>evaluated use cases</small></article>
            <article><span>MITRE mapped</span><strong id="life-mitre-mapped">0</strong><small>recommendations with ATT&amp;CK</small></article>
            <article><span>Field verified</span><strong id="life-field-verified">0</strong><small>requirements satisfied</small></article>
            <article><span>Telemetry ready</span><strong id="life-telemetry-ready">0</strong><small>ready for design</small></article>
            <article><span>SPL generated</span><strong id="life-spl-generated">0</strong><small>persisted search artifacts</small></article>
          </section>

          <section class="dei-lifecycle-section dei-pipeline-section">
            <div class="dei-lifecycle-section-head"><div><p class="dei-eyebrow">Intelligence Pipeline</p><h2>Evidence-to-detection workflow</h2><p>Metrics advance only when DEI has evidence for the corresponding engineering outcome.</p></div><span class="dei-lifecycle-contract">Platform-first · ES-enhanced</span></div>
            <div id="dei-detection-flow" class="dei-detection-flow" data-flow-state="idle" style="--dei-flow-progress:0%">
              <div class="dei-flow-header"><div><span class="dei-flow-live-dot"></span><strong>Detection intelligence flow</strong></div><span id="dei-flow-status">Awaiting environment evidence</span></div>
              <div class="dei-flow-rail" aria-hidden="true"><span class="dei-flow-complete-track"></span><i class="dei-flow-packet packet-one"></i><i class="dei-flow-packet packet-two"></i><i class="dei-flow-packet packet-three"></i></div>
              <div class="dei-flow-nodes" aria-hidden="true">
                <span data-flow-stage="discover"><b>01</b><small>Discover</small></span>
                <span data-flow-stage="profile"><b>02</b><small>Profile</small></span>
                <span data-flow-stage="qualify"><b>03</b><small>Qualify</small></span>
                <span data-flow-stage="recommend"><b>04</b><small>Recommend</small></span>
                <span data-flow-stage="design"><b>05</b><small>Design</small></span>
                <span data-flow-stage="generate"><b>06</b><small>Generate</small></span>
                <span data-flow-stage="validate"><b>07</b><small>Validate</small></span>
              </div>
            </div>
            <div class="dei-pipeline-grid">
              <article class="available dei-pipeline-stage" data-stage="discover" data-filter-state="recommendation" data-pipeline-state="upcoming" role="button" tabindex="0"><span>01</span><h3>Discover</h3><strong id="stage-discover">0 sources</strong><p>Bounded index and sourcetype inventory.</p></article>
              <article class="available dei-pipeline-stage" data-stage="profile" data-filter-state="recommendation" data-pipeline-state="upcoming" role="button" tabindex="0"><span>02</span><h3>Profile</h3><strong id="stage-profile">0 profiled</strong><p>Fields, events, values, quality, and CIM evidence.</p></article>
              <article class="available dei-pipeline-stage" data-stage="qualify" data-filter-state="recommendation" data-pipeline-state="upcoming" role="button" tabindex="0"><span>03</span><h3>Qualify</h3><strong id="stage-qualify">0 verified</strong><p>Prerequisites, mappings, and explicit data gaps.</p></article>
              <article class="available dei-pipeline-stage" data-stage="recommend" data-filter-state="recommendation" data-pipeline-state="upcoming" role="button" tabindex="0"><span>04</span><h3>Recommend</h3><strong id="stage-recommend">0 use cases</strong><p>Explainable readiness and ATT&amp;CK coverage.</p></article>
              <article class="partial dei-pipeline-stage" data-stage="design" data-filter-state="draft" data-pipeline-state="upcoming" role="button" tabindex="0"><span>05</span><h3>Design</h3><strong id="stage-design">0 ready</strong><p>Open Detection Definition and engineering guidance.</p></article>
              <article class="planned dei-pipeline-stage" data-stage="generate" data-filter-state="draft" data-pipeline-state="upcoming" role="button" tabindex="0"><span>06</span><h3>Generate</h3><strong id="stage-generate">0 SPL</strong><p>Versioned platform and optional ES templates.</p></article>
              <article class="planned dei-pipeline-stage" data-stage="validate" data-filter-state="testing" data-pipeline-state="upcoming" role="button" tabindex="0"><span>07</span><h3>Validate</h3><strong id="stage-validate">0 passed</strong><p>Historical tests, runtime, volume, and entity evidence.</p></article>
            </div>
          </section>

          <section class="dei-lifecycle-section dei-state-section">
            <div class="dei-lifecycle-section-head"><div><p class="dei-eyebrow">Managed Lifecycle</p><h2>Operational detection states</h2><p>A recommendation is not a production detection. Persisted artifacts and analyst decisions advance each state.</p></div><span class="dei-lifecycle-contract">Analyst controlled</span></div>
            <div class="dei-state-grid">
              <article><span>Draft</span><strong id="state-draft">0</strong><small>design artifacts</small></article>
              <article><span>Testing</span><strong id="state-testing">0</strong><small>validation active</small></article>
              <article><span>Peer review</span><strong id="state-review">0</strong><small>awaiting decision</small></article>
              <article><span>Catalog ready</span><strong id="state-catalog">0</strong><small>approved; awaiting enablement</small></article>
              <article><span>Production</span><strong id="state-production">0</strong><small>approved deployments</small></article>
              <article><span>Monitoring</span><strong id="state-monitoring">0</strong><small>health measured</small></article>
              <article><span>Tuning</span><strong id="state-tuning">0</strong><small>revisions active</small></article>
              <article><span>Retired</span><strong id="state-retired">0</strong><small>history retained</small></article>
            </div>
          </section>

        </div>
      </html>
    </panel>
  </row>
</form>

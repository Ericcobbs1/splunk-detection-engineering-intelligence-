        <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a href="command_center">Discover</a><a href="mitre_coverage">Coverage</a><a href="detection_workflow">Build</a><a href="detection_catalog">Operate</a><a class="active" href="detection_health">Health</a></nav>
      </section>

      <header class="dei-health-detail-hero"><div><p class="dei-eyebrow">Continuous detection assurance</p><h1>Detection lifecycle and health metrics</h1><p>Measure whether detections remain deployed, observable, efficient, analytically useful, reviewed, and supported by current evidence.</p></div><div><a class="dei-link-button" href="detection_health">Health overview</a><button id="health-detail-refresh" type="button">Refresh metrics</button></div></header>

      <section class="dei-health-scope" aria-labelledby="health-scope-title"><div><span>Scope</span><h2 id="health-scope-title">Portfolio overview</h2><p id="health-scope-summary">All enabled, disabled, draft, monitoring, tuning, and retired detection records.</p></div><label><span>Filter detection</span><select id="health-detection-filter"><option value="all">All detections · enabled and disabled</option></select></label></section>


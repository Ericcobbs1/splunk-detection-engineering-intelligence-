<form version="1.1" theme="dark" script="dei_lifecycle_store_v1.js,detection_lifecycle_v2.js,detection_catalog_v2.js,dei_environment_scan_v1.js,dei_guide_adapter_v4.js,dei_workspace_layout_v13.js" stylesheet="command_center_v2.css,dei_visual_polish_v1.css,detection_lifecycle_v1.css,dei_workspace_layout_v1.css,detection_catalog_v1.css,dei_guided_tour_v6.css,dei_responsive_v1.css,dei_design_system_v1.css">
  <label>Detection Catalog</label>
  <description>Approved and operational detections available for controlled enablement and monitoring.</description>
  <fieldset submitButton="false" autoRun="false"></fieldset>
  <row>
    <panel>
      <html>
        <main id="dei-detection-catalog-page" class="dei-shell dei-lifecycle-page dei-catalog-page">
          <section class="dei-product-bar" aria-label="DEI workspace navigation">
            <div class="dei-product-brand"><span class="dei-brand-mark">DEI</span><div><strong>Detection Engineering Intelligence</strong><span>Detection Catalog</span></div></div>
            <nav class="dei-workspace-nav"><a href="dei_home">Home</a><a href="command_center">Discover</a><a href="mitre_coverage">Coverage</a><a href="detection_workflow">Build</a><a class="active" href="detection_catalog">Operate</a></nav>
            <div id="catalog-data-status" class="dei-status">Catalog: loading</div>
          </section>

          <section class="dei-lifecycle-section dei-lifecycle-queue-section" data-visible-rows="10">
            <div class="dei-lifecycle-section-head"><div><p class="dei-eyebrow">Engineering Work Queue</p><h2>Continue active detection work</h2><p>Filter recommendations and in-progress detections, then continue the next governed action in the unified builder.</p></div><span id="lifecycle-queue-count" class="dei-chip">0 items</span></div>
            <div class="dei-lifecycle-filters"><input id="lifecycle-search" type="search" placeholder="Filter detections, sourcetypes, MITRE, or lifecycle state..."/><select id="lifecycle-readiness"><option value="all">All readiness</option><option value="production_ready">Telemetry ready</option><option value="partial">Partial telemetry</option><option value="field_gap">Field gap</option><option value="field_unverified">Field unverified</option><option value="unsupported">Unsupported</option><option value="requires_enterprise_security">Requires ES</option></select><select id="lifecycle-stage"><option value="all">All engineering states</option><option value="recommendation">Recommendation</option><option value="draft">Draft</option><option value="testing">Testing</option><option value="peer_review">Peer review</option><option value="tuning">Tuning</option></select><label class="dei-queue-row-filter"><span>Rows in view</span><select id="lifecycle-visible-rows"><option value="10" selected="selected">10 rows</option><option value="25">25 rows</option></select></label><button id="lifecycle-reset-filters" type="button">Reset filters</button></div>
            <div class="dei-lifecycle-table-wrap"><table class="dei-lifecycle-table"><thead><tr><th>Detection opportunity</th><th>Observed sourcetype</th><th>Readiness</th><th>MITRE ATT&amp;CK</th><th>Current stage</th><th>Next required action</th><th>Build</th></tr></thead><tbody id="lifecycle-work-queue"><tr><td colspan="7">Run an intelligence scan to populate the lifecycle queue.</td></tr></tbody></table></div>
          </section>

          <details id="lifecycle-map" class="dei-workspace-disclosure dei-lifecycle-map">
            <summary><span><strong>How detections move through DEI</strong><small>Open the animated lifecycle map and select a stage to filter active work.</small></span></summary>
            <div class="dei-lifecycle-map-intro"><p><strong>Purpose:</strong> this lifecycle keeps every detection evidence-driven, reviewable, reversible, and operationally monitored from telemetry discovery through retirement.</p><span id="dei-flow-status" aria-live="polite">Select a stage to focus the Engineering Work Queue.</span></div>
            <div id="dei-detection-flow" class="dei-pipeline-grid" aria-label="Detection engineering lifecycle">
              <article class="available dei-pipeline-stage" data-stage="discover" data-filter-state="recommendation" role="button" tabindex="0"><span>01</span><h3>Discover</h3><strong id="stage-discover">Telemetry</strong><p>Find active sources.</p></article>
              <article class="available dei-pipeline-stage" data-stage="profile" data-filter-state="recommendation" role="button" tabindex="0"><span>02</span><h3>Profile</h3><strong id="stage-profile">Evidence</strong><p>Verify fields and quality.</p></article>
              <article class="available dei-pipeline-stage" data-stage="qualify" data-filter-state="recommendation" role="button" tabindex="0"><span>03</span><h3>Qualify</h3><strong id="stage-qualify">Readiness</strong><p>Confirm prerequisites.</p></article>
              <article class="available dei-pipeline-stage" data-stage="recommend" data-filter-state="recommendation" role="button" tabindex="0"><span>04</span><h3>Recommend</h3><strong id="stage-recommend">Use case</strong><p>Map ATT&amp;CK value.</p></article>
              <article class="partial dei-pipeline-stage" data-stage="design" data-filter-state="draft" role="button" tabindex="0"><span>05</span><h3>Design</h3><strong id="stage-design">Draft</strong><p>Build governed logic.</p></article>
              <article class="planned dei-pipeline-stage" data-stage="generate" data-filter-state="draft" role="button" tabindex="0"><span>06</span><h3>Generate</h3><strong id="stage-generate">SPL</strong><p>Create the artifact.</p></article>
              <article class="planned dei-pipeline-stage" data-stage="validate" data-filter-state="testing" role="button" tabindex="0"><span>07</span><h3>Validate</h3><strong id="stage-validate">Evidence</strong><p>Test, review, deploy.</p></article>
            </div>
          </details>

          <section class="dei-lifecycle-hero dei-catalog-hero">
            <div><p class="dei-eyebrow">Operational Detection Catalog</p><h1>Enable and operate approved detections.</h1><p>Peer-approved detections leave the engineering queue and enter this governed catalog. Record the exact platform object before enablement, then manage monitoring, tuning, disablement, or retirement.</p></div>
            <div class="dei-lifecycle-hero-state"><span>Cataloged detections</span><strong id="catalog-total">0</strong><small>approved and operational</small></div>
          </section>

          <section class="dei-catalog-summary" aria-label="Catalog status summary">
            <button type="button" data-catalog-filter="all" class="active"><span>All cataloged</span><strong id="catalog-count-all">0</strong></button>
            <button type="button" data-catalog-filter="ready"><span>Ready to deploy</span><strong id="catalog-count-ready">0</strong></button>
            <button type="button" data-catalog-filter="enabled"><span>Operational</span><strong id="catalog-count-enabled">0</strong></button>
            <button type="button" data-catalog-filter="monitoring"><span>Needs monitoring</span><strong id="catalog-count-monitoring">0</strong></button>
            <span hidden="hidden"><strong id="catalog-count-development">0</strong><strong id="catalog-count-staging">0</strong><strong id="catalog-count-disabled">0</strong></span>
          </section>

          <section class="dei-lifecycle-section dei-catalog-workspace">
            <div class="dei-lifecycle-section-head"><div><p class="dei-eyebrow">Detection Portfolio</p><h2>Approved detection catalog</h2><p id="catalog-results-summary" aria-live="polite">Loading lifecycle records…</p></div><button id="catalog-refresh" type="button">Refresh catalog</button></div>
            <div class="dei-catalog-filters"><input id="catalog-search" type="search" placeholder="Search detection, MITRE ID, sourcetype, or object ID…"/><select id="catalog-status-filter"><option value="all">All catalog states</option><option value="ready">Ready to deploy</option><option value="development">Development</option><option value="staging">Staging</option><option value="enabled">Production enabled</option><option value="disabled">Disabled</option><option value="monitoring">Monitoring</option><option value="retired">Retired</option></select><button id="catalog-reset-filters" type="button">Reset filters</button></div>
            <div class="dei-lifecycle-table-wrap"><table class="dei-lifecycle-table"><thead><tr><th>Detection</th><th>MITRE ATT&amp;CK</th><th>Lifecycle</th><th>Catalog status</th><th>Deployment object</th><th>Health</th><th>Action</th></tr></thead><tbody id="catalog-table"><tr><td colspan="7">Loading detection catalog…</td></tr></tbody></table></div>
          </section>

          <section id="catalog-action-panel" class="dei-lifecycle-section dei-catalog-action" hidden="hidden" aria-labelledby="catalog-action-title">
            <div class="dei-lifecycle-section-head"><div><p class="dei-eyebrow">Catalog Control</p><h2 id="catalog-action-title">Select a detection</h2><p id="catalog-action-summary">Review the approved artifact before enabling it.</p></div><span id="catalog-action-state" class="dei-lifecycle-contract">Not selected</span></div>
            <div id="catalog-action-evidence" class="dei-catalog-evidence"></div>
            <div id="catalog-enable-fields" class="dei-catalog-enable-fields">
              <label><span>Deployment target *</span><select id="catalog-deployment-target"><option value="splunk_platform">Splunk saved search</option><option value="enterprise_security">Enterprise Security detection</option><option value="external">External deployment</option></select><small id="catalog-target-help">Choose where the governed detection object is managed.</small></label>
              <label><span>Environment *</span><select id="catalog-deployment-environment"><option value="production">Production</option><option value="staging">Staging</option><option value="development">Development</option></select></label>
              <label class="wide"><span id="catalog-external-id-label">Saved-search or detection object ID *</span><input id="catalog-external-id" type="text" placeholder="DEI - Detection Name - Production" aria-describedby="catalog-external-id-help"/><small id="catalog-external-id-help">Enter the exact deployed object name, not the DEI detection ID.</small></label>
              <label class="wide"><span>Enablement note</span><textarea id="catalog-enable-note" placeholder="Change ticket, deployment evidence, or operational note"></textarea></label>
            </div>
            <div id="catalog-action-feedback" class="dei-action-feedback" role="status" aria-live="polite">Catalog changes preserve peer-review and lifecycle history.</div>
            <div id="catalog-action-buttons" class="dei-generator-actions"></div>
          </section>
        </main>
      </html>
    </panel>
  </row>
</form>

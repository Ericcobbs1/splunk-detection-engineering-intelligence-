{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dei.dev/schemas/knowledge-pack.schema.json",
  "title": "DEI Knowledge Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","name","version","minimum_dei_version","domains","supported_sources","capabilities"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type":"string","minLength":3},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "minimum_dei_version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type":"string"},
    "author": {"type":"string"},
    "domains": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["identity","endpoint","network","cloud","ai","email","application","database","ot"]}},
    "supported_sources": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "capabilities": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*$"}},
    "requires_enterprise_security": {"type":"boolean","default":false}
  }
}
